  "intro": {
    "eyebrow": "Free website template",
    "title": "A website for your league, from its score sheets",
    "text": "A free template for a small recreational league: standings, schedule, results, player stats and past seasons, kept by one volunteer from the paper score sheets. Each sport below is a working demo with a made-up league."
  },
  "links": [
    {
      "label": "Setup guide (short version)",
      "url": "https://github.com/kylermurphy/scorers-table#publish-it",
      "note": "How to publish your league's site with GitHub Pages."
    },
    {
      "label": "The code on GitHub",
      "url": "https://github.com/kylermurphy/scorers-table",
      "note": "kylermurphy/scorers-table"
    }
  ],
  "features_title": "What every league gets",
  "features": [
    "Standings, schedule, results and player stats, worked out from your score sheets.",
    "Past seasons kept for good.",
    "Made for phones first, in light and dark.",
    "Players shown as \"First L.\" only, never full names, contact details or photos.",
    "No ads, trackers or cookie banners.",
    "Hidden from search engines unless your league says otherwise."
  ],
  "copy_note": "Copying this template? Set landing_page: false in league.yml to put your league's own site at the front page.",
